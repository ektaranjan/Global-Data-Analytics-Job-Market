# Keep text portable and prevent binary artifacts from being treated as source diffs.
* text=auto
*.py text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.csv text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.db binary
